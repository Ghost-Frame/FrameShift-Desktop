{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Exact app-version, event-listener, signed-updater, restart, deep-link, and project-folder dialog commands used by the main window.",
  "windows": ["main"],
  "permissions": [
    "core:app:allow-version",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "updater:allow-check",
    "updater:allow-download-and-install",
    "process:allow-restart",
    "deep-link:allow-get-current",
    "dialog:allow-open"
  ]
}
