{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FrameShift",
  "version": "0.1.6",
  "identifier": "io.ghostframe.frameshift",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "FrameShift",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://frameshift-api.syntheos.dev https://dl.frameshift.syntheos.dev; object-src 'none'; frame-ancestors 'none'"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["frameshift"]
      }
    },
    "updater": {
      "endpoints": ["https://dl.frameshift.syntheos.dev/desktop/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMwMDg1QTQwNUM3RTY2RUMKUldUc1puNWNRRm9Jd0VqSStLM1grZHlrNDVVOUErVjVEZkx3cGEzbDUrZ3JnWjN3aUc2WXdCYmIK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": ["resources/tools/*"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
